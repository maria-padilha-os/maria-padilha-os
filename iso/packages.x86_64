# Packages installed into the Maria Padilha live root.
# Build-only tooling stays in the throw-away Arch container; only runtime
# packages belong here. build.sh keeps the compiler toolchain out of the ISO.

# Base system and archiso boot support
base
linux
mkinitcpio-archiso
plymouth
squashfs-tools
syslinux
zstd

# CPU microcode and firmware. linux-firmware is the Arch meta package; the
# vendor splits document the hardware classes the reference laptop needs.
# Keep this a class list, not a per-model quirk list: AMD CPU/GPU, the common
# Wi-Fi/Bluetooth vendors, and Intel fallback for best-effort hardware.
amd-ucode
intel-ucode
linux-firmware
linux-firmware-amd
linux-firmware-amdgpu
linux-firmware-atheros
linux-firmware-broadcom
linux-firmware-intel
linux-firmware-mediatek
linux-firmware-realtek

# Graphics: the AMD Radeon user-space stack beside the amdgpu firmware above.
mesa
vulkan-radeon
libva
libva-utils

# Live user, installer helpers and diagnostics
sudo
arch-install-scripts
parted
gptfdisk
e2fsprogs
dosfstools

# Rescue entry: filesystem inspection/repair and bootloader repair.  These are
# in the live squashfs on purpose; the rescue menu boots this same image with
# maria-padilha.rescue=1 instead of the graphical session.  Keep the rescue
# unit, docs/rescue.md and tests/rescue.sh in sync when changing this list.
btrfs-progs
xfsprogs
f2fs-tools
exfatprogs
ntfs-3g
grub
efibootmgr

# Networking and Bluetooth
networkmanager
network-manager-applet
wpa_supplicant
wireless-regdb
iw
bluez
bluez-utils

# Session services: seats, power/thermal reporting and the user audio stack.
# power-profiles-daemon is the single power manager; TLP, auto-cpufreq and
# thermald are intentionally absent so they cannot fight it.
seatd
power-profiles-daemon
upower
lm_sensors
acpi
pciutils
usbutils

# Audio, including Sound Open Firmware and the ALSA UCM profiles used by
# modern AMD laptop codecs.
pipewire
pipewire-pulse
pipewire-alsa
wireplumber
alsa-utils
alsa-ucm-conf
sof-firmware
pavucontrol

# Hyprland, Quickshell and the Maria Padilha session
hyprland
quickshell
qt6-base
qt6-declarative
qt6-wayland
qt6-svg
xdg-desktop-portal
xdg-desktop-portal-hyprland
xdg-desktop-portal-gtk
xdg-utils
xdg-user-dirs
polkit
polkit-gnome
gnome-keyring
gsettings-desktop-schemas
hyprlock
hypridle
hyprsunset
playerctl
grim
slurp
swappy
wl-clipboard
cliphist
fuzzel
brightnessctl
trash-cli
jq
micro

# Fonts used by the Quickshell bar, terminals and the Hyprland UI
ttf-jetbrains-mono-nerd
ttf-nerd-fonts-symbols
noto-fonts
noto-fonts-emoji
otf-font-awesome
ttf-dejavu

# Display manager: greetd + tuigreet (the only greeter this profile supports)
greetd
greetd-tuigreet

# The desktop package, served from the local repository build.sh creates.
maria-padilha
